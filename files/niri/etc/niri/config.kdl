// Include our variables at the very top of the file

input {
    keyboard { xkb; }
    touchpad { tap; natural-scroll; }
    focus-follows-mouse max-scroll-amount="0%"
}

environment {
    QT_QPA_PLATFORM "wayland"
    QT_QPA_PLATFORMTHEME "qt6ct"
    ELECTRON_OZONE_PLATFORM_HINT "auto"
}

layout {
    gaps 16
    background-color "transparent"
    center-focused-column "never"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }
    default-column-width { proportion 0.5; }

    focus-ring {
        width 4
        active-color "#7fc8ff"
        inactive-color "#505050"
    }
    border { off; }
    shadow { softness 30; spread 5; offset x=0 y=5; color "#0007"; }
}

hotkey-overlay { skip-at-startup; }
prefer-no-csd
screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

// ----------------------------------------------------------------
// Window Rules
// ----------------------------------------------------------------
window-rule {
    match app-id=r#"^org\.wezfurlong\.wezterm$"#
    default-column-width { proportion 0.5; }
}
window-rule {
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    open-floating true
}
window-rule {
    geometry-corner-radius 20
    clip-to-geometry true
}

window-rule {
    match is-active=false
    opacity 0.9
}

// ----------------------------------------------------------------
// Keybinds
// ----------------------------------------------------------------
binds {
    // Core Applications
    Mod+Return         { spawn "ghostty"; }
    Mod+B              { spawn "helium-browser-bin"; }
    Mod+G              { spawn "steam"; }
    Mod+E              { spawn "caja"; }

    // Generic Window Actions
    Mod+Q repeat=false { close-window; }
    Mod+F              { maximize-column; }
    Mod+Shift+F        { fullscreen-window; }
    Mod+Ctrl+F         { expand-column-to-available-width; }
    Mod+C              { center-column; }
    Mod+V              { toggle-window-floating; }
    Mod+W              { toggle-column-tabbed-display; }

    // Navigation & Layout Maps
    Mod+Left           { focus-column-left; }
    Mod+Down           { focus-window-down; }
    Mod+Up             { focus-window-up; }
    Mod+Right          { focus-column-right; }

    Mod+Ctrl+Left      { move-column-left; }
    Mod+Ctrl+Down      { move-window-down; }
    Mod+Ctrl+Up        { move-window-up; }
    Mod+Ctrl+Right     { move-column-right; }

    Mod+Page_Down      { focus-workspace-down; }
    Mod+Page_Up        { focus-workspace-up; }
    Mod+Ctrl+Page_Down { move-column-to-workspace-down; }
    Mod+Ctrl+Page_Up   { move-column-to-workspace-up; }

    // Workspace Quick-Keys
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+Ctrl+1 { move-column-to-workspace 1; }
    Mod+Ctrl+2 { move-column-to-workspace 2; }
    Mod+Ctrl+3 { move-column-to-workspace 3; }
    Mod+Ctrl+4 { move-column-to-workspace 4; }
    Mod+Ctrl+5 { move-column-to-workspace 5; }
    Mod+Ctrl+6 { move-column-to-workspace 6; }
    Mod+Ctrl+7 { move-column-to-workspace 7; }
    Mod+Ctrl+8 { move-column-to-workspace 8; }
    Mod+Ctrl+9 { move-column-to-workspace 9; }

    // System Exits
    Mod+Shift+E        { quit; }
    Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }

    // Session and System Controls
    Mod+L { spawn "noctalia" "msg" "session" "lock"; }
    Mod+X { spawn "noctalia" "msg" "panel-toggle" "session"; }
    Mod+I { spawn "noctalia" "msg" "caffeine-toggle"; }
    Mod+Z { spawn "noctalia" "msg" "settings-toggle"; }
    Mod+Space { spawn "noctalia" "msg" "panel-toggle" "launcher"; }
    Mod+A { spawn "noctalia" "msg"  "notifications" "toggleHistory"; }

    // Audio Controls (Locked & Repeating)
    XF86AudioRaiseVolume  { spawn "noctalia" "msg" "volume-up"; }
    XF86AudioLowerVolume  { spawn "noctalia" "msg" "volume-down"; }
    XF86AudioMute         { spawn "noctalia" "msg" "volume-mute"; }

    // Media Controls (Locked)
    XF86AudioPlay  { spawn "noctalia" "msg" "media-play"; }
    XF86AudioNext  { spawn "noctalia" "msg" "media-next"; }
    XF86AudioPrev  { spawn "noctalia" "msg" "media-prev"; }

    // Brightness Controls (Repeating)
    XF86MonBrightnessUp   cooldown-ms=50 { spawn "noctalia" "msg" "brightness-up"; }
    XF86MonBrightnessDown cooldown-ms=50 { spawn "noctalia" "msg" "brightness-down"; }

    // Screen Capture
    Print { spawn "noctalia" "msg" "screenshot-region"; }
    Mod+Print { spawn "noctalia" "msg" "screenshot-fullscreen"; }
    Mod+M { spawn "noctalia" "msg" "clipboard-clear"; }

    // Theming
    Mod+Y { spawn "noctalia" "msg" "wallpaper-random"; }
}

layer-rule {
  match namespace="^noctalia-wallpaper*"
  place-within-backdrop true
}
spawn-at-startup "noctalia"

config-notification { disable-failed; }
